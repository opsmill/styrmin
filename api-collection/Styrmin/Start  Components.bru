meta {
  name: Start  Components
  type: graphql
  seq: 16
}

post {
  url: {{api_url}}
  body: graphql
  auth: none
}

body:graphql {
  mutation StartComponents(
    $deploymentId: UUID! 
    $components: [String!]!
  ) {
    startComponents(
      deploymentId: $deploymentId
      components: $components
    ) {
      id
      type
      status
      message
      deploymentId
    }
  }
}

body:graphql:vars {
  {
    "deploymentId": "{{deployment_id}}",
    "components": ["server", "task-worker"]
  }
}
