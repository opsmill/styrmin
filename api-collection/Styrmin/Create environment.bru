meta {
  name: Create environment
  type: graphql
  seq: 2
}

post {
  url: {{api_url}}
  body: graphql
  auth: none
}

body:graphql {
  mutation CreateEnvironment($name: String!, $clusterId: UUID!, $config: JSON) {
    createEnvironment(name: $name, clusterId: $clusterId, config: $config) {
      id
      name
      config
      cluster {
        id
        name
      }
    }
  }

}

body:graphql:vars {
  {
    "name": "test-environment",
    "clusterId": "{{cluster_id}}",
    "config": {
      "ip_whitelist": [
        "127.0.0.1"
      ]
    }
  }
}

vars:post-response {
  environment_id: res.body.data.createEnvironment.id
}
