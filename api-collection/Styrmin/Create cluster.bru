meta {
  name: Create cluster
  type: graphql
  seq: 1
}

post {
  url: {{api_url}}
  body: graphql
  auth: none
}

body:graphql {
  mutation CreateCluster($name: String!, $config: JSON) {
    createCluster(name: $name, config: $config) {
      id
      name
      config
    }
  }

}

body:graphql:vars {
  {
    "name": "test-cluster",
    "config": {
      "fqdn_suffix": "styrmin.com",
      "ingress_class": "traefik",
      "dedicated_ingress": "traefik",
      "runtime_class": "",
      "standard_storage": {
        "storage_class": "standard"
      }
    }
  }
}

vars:post-response {
  cluster_id: res.body.data.createCluster.id
}
