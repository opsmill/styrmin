meta {
  name: Get task
  type: graphql
  seq: 12
}

post {
  url: {{api_url}}
  body: graphql
  auth: none
}

body:graphql {
  query GetTask(
    $taskId: UUID!
  ) {
    task(
      taskId: $taskId
    ) {
      id
      type
      status
      message
      deploymentId
    }
  }
  
}

body:graphql:vars {
  {
    "taskId": "{{task_id}}"
  }
}
