        "ip_families": ["IPv4"],
        "ip_family_policy": "SingleStack",
        "node_port": 30443
      }
    },
    "standard_storage": {
      "storage_class": "standard-rwo"
    },
    "fast_storage": {
      "storage_class": "local-nvme"
    },
    "db_size": "10Gi",
    "backup_ttl": "720h"
  },
