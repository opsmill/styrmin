    "fqdn_suffix": "apps.example.com",
    "external_url_scheme": "http",
    "external_url_port": 8443,
    "external_dns_endpoints_type": "NodeExternalIP",
    "dedicated_ingress": {
      "implementation": "traefik",
      "type": "ingress",
      "service": {
        "type": "NodePort",
        "annotations": {
          "lb.example.com/reuse": "true"
        },
        "load_balancer_ip": "10.0.0.10",
